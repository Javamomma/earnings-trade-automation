# --- Broker / integrations ---
APCA_API_KEY_ID=your_alpaca_key_id
APCA_API_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=true
GOOGLE_SCRIPT_URL=deployed_google_script_url
# Optional: must match AUTH_TOKEN set in the Apps Script's Script Properties.
GOOGLE_SCRIPT_TOKEN=

# --- Screening thresholds (defaults preserve legacy behavior) ---
MIN_AVG_VOLUME=1500000
MIN_IV30_RV30=1.25
MAX_TS_SLOPE_0_45=-0.00406

# --- Position sizing ---
KELLY_FRACTION=0.06
# false = legacy behavior (equity minus realized profit * factor).
# true  = Kelly on raw equity (standard compounding).
KELLY_USE_RAW_EQUITY=false
PROFIT_ADJUSTMENT_FACTOR=0.5

# --- Close-side guardrails ---
# Max debit as a multiple of the original open debit (cap on how much
# of a loss we'll accept during the creeping close).
MAX_CLOSE_DEBIT_MULTIPLE=1.0
MAX_CLOSE_DEBIT_ABS=10.0

# --- Commissions (Alpaca Order model doesn't expose per-fill fees) ---
COMMISSION_PER_CONTRACT=0.0

# --- Logging ---
LOG_LEVEL=INFO