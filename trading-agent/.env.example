# Required for SEC EDGAR access — they require a real contact in the User-Agent.
SEC_USER_AGENT="Your Name your.email@example.com"

# Discord webhook (Server Settings -> Integrations -> Webhooks).
DISCORD_WEBHOOK_URL=

# Reddit JSON API uses no auth but still requires a polite User-Agent.
REDDIT_USER_AGENT="trading-agent/0.1 (by /u/yourhandle)"

# Where to store the SQLite trade journal (relative to trading-agent/).
JOURNAL_DB_PATH=data/journal.db

# Minimum research priority score (0-100) for a radar ticker to render in
# the daily brief.
PRIORITY_RENDER_THRESHOLD=40

# Minimum research priority score to trigger a Discord alert.
PRIORITY_ALERT_THRESHOLD=70

# Markdown report tone: "obsidian" adds frontmatter + wikilinks; "plain"
# emits portable Markdown.
REPORT_STYLE=obsidian

# Reports directory (relative to trading-agent/).
REPORTS_DIR=reports

# Reddit OAuth (app-only). Reddit now 403s unauthenticated .json scraping, so a
# free "script" app (https://www.reddit.com/prefs/apps) is needed for the reddit
# mention-acceleration signal. Leave blank to disable that signal gracefully.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
